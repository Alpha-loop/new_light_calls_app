EXPO_PUBLIC_API_URL=https://unionfaith.azurewebsites.net/api

# Set this to the Light Calls tenant GUID (the app loads nothing without it)
EXPO_PUBLIC_TENANT_ID=4CED577D-9F2A-43F0-9356-A96ED1FE73CC

APP_NAME=Light Calls
APP_SLUG=light-calls
APP_ICON=./assets/fsgc.png
APP_SPLASH_IMAGE=./assets/fsgc.png
APP_SPLASH_BACKGROUND_COLOR=#FFFFFF
NOTIFICATION_ICON_COLOR=#000000

IOS_BUNDLE_IDENTIFIER=com.churchplus.lightcalls
ANDROID_PACKAGE=com.churchplus.lightcalls

# Run `eas init` in this folder and paste the NEW project ID here.
# (Do not reuse another app's project ID.)
EAS_PROJECT_ID=2603cc75-8641-4735-b53e-3e38b110775e

EXPO_PUBLIC_PRIVACY_POLICY_URL=https://www.churchplus.com/privacy-policy
